  "cards": [
    {
      "dot": "cyan",
      "title": "O que o analista faz",
      "items": [
        "Conversa com o agente e aprova cada artefato antes da gravação",
        "Acompanha o PR no navegador e pede a revisão"
      ]
    },
    {
      "dot": "emerald",
      "title": "O que roda sozinho",
      "items": [
        "regenera-gerados grava o espelho do INDEX, o diagrama ER, os dicionários e o HTML da AIMM",
        "spec-guard e gate-check conferem cada push; o agente lê o resultado pelo MCP",
        "O Pages publica a prévia da branch"
      ]
    },
    {
      "dot": "rose",
      "title": "Credenciais",
      "items": [
        "O agente grava com a conta do analista (OAuth)",
        "O workflow grava com o GitHub App, para que os checks rodem de novo",
        "A main só recebe PR aprovado"
      ]
    }
  ]
